{
  "name": "@api18n/cli",
  "version": "0.1.4",
  "description": "Command-line interface for the api18n translation manager. Pull translations to local JSON files and push edits back as reviewable proposals.",
  "license": "MIT",
  "author": "api18n",
  "homepage": "https://github.com/api18n-app/api18n-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/api18n-app/api18n-cli.git"
  },
  "bugs": {
    "url": "https://github.com/api18n-app/api18n-cli/issues"
  },
  "keywords": [
    "api18n",
    "i18n",
    "internationalization",
    "translations",
    "localization",
    "cli",
    "json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "api18n": "bin/api18n.mjs"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "start": "node bin/api18n.mjs"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^2.7.8",
    "bundle-require": "^5.0.0",
    "commander": "^12.1.0",
    "esbuild": "^0.24.0",
    "kleur": "^4.1.5",
    "ora": "^9.4.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}