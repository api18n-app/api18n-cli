{
  "name": "@api18n/cli",
  "version": "0.1.0",
  "description": "Command-line interface for the api18n translation manager. Pull translations to local JSON files and (later) push edits back as reviewable proposals.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "api18n": "./bin/api18n.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --clean --out-dir dist --shims --dts",
    "dev": "tsup src/index.ts --format esm --target node18 --watch --out-dir dist --shims --dts",
    "typecheck": "tsc --noEmit",
    "start": "node bin/api18n.mjs"
  },
  "dependencies": {
    "bundle-require": "^5.0.0",
    "commander": "^12.1.0",
    "esbuild": "^0.24.0",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
